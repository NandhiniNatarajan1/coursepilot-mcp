# Canvas API Configuration
CANVAS_API_TOKEN=your_canvas_api_token_here
CANVAS_BASE_URL=https://your-institution.instructure.com

# Google Calendar Configuration
GOOGLE_CREDENTIALS_JSON=./credentials.json

# Application Settings
LOG_LEVEL=INFO

# Optional: comma-separated substrings that must appear in a course_code
# for the course to be synced. Leave empty to sync every active course.
# Example for Northeastern Fall 2026: TERM_FILTER=202710
TERM_FILTER=
